typeset -ga REG_IDS REG_DISP REG_RANK REG_PRE REG_ENV REG_REF REG_URL REG_ORDER
reg_load() {
  (( ${#REG_IDS} )) && return 0
  local id disp rank pre env ref url i j
  while IFS='|' read -r id disp rank pre env ref url; do
    [[ -z "$id" ]] && continue
    REG_IDS+=("$id"); REG_DISP+=("$disp"); REG_RANK+=("$rank")
    REG_PRE+=("$pre"); REG_ENV+=("$env"); REG_REF+=("$ref"); REG_URL+=("$url")
  done <<< "$REGISTRY"
  # display order = what you reached for most recently, then popularity.
  local -a by_rank recent_idx
  by_rank=( ${(f)"$(for j in {1..${#REG_IDS}}; do printf '%s %s\n' "${REG_RANK[$j]}" "$j"; done | sort -n -k1,1 -k2,2n | cut -d' ' -f2)"} )
  local r
  if [[ -f "$RECENT" ]]; then
    while IFS= read -r r; do
      [[ -z "$r" ]] && continue
      j=$(reg_idx "$r") || continue
      [[ -n "$j" ]] && recent_idx+=("$j")
    done < "$RECENT"
  fi
  REG_ORDER=( $recent_idx )
  for j in $by_rank; do
    (( ${REG_ORDER[(Ie)$j]} )) || REG_ORDER+=("$j")
  done
}
reg_idx() {   # id -> array index, empty if unknown
  local i
  (( ${#REG_IDS} )) || return 1
  for i in {1..${#REG_IDS}}; do [[ "${REG_IDS[$i]}" == "$1" ]] && { print "$i"; return 0 } done
  return 1
}
reg_bump() {  # remember what was used, most-recent-first, capped
  local id="$1" tmp
  tmp=$(mktemp); { print "$id"; [[ -f "$RECENT" ]] && grep -vxF "$id" "$RECENT" || true; } | head -12 > "$tmp"
  mv "$tmp" "$RECENT"
}

# the point of the registry: name a value on sight. longest prefix wins.
detect_provider() {
  local v="$1" i p best="" bestlen=0
  reg_load
  for i in {1..${#REG_IDS}}; do
    [[ -z "${REG_PRE[$i]}" ]] && continue
    for p in ${(s:,:)REG_PRE[$i]}; do
      [[ "$v" == "$p"* ]] && (( ${#p} > bestlen )) && { best="${REG_IDS[$i]}"; bestlen=${#p} }
    done
  done
  print -r -- "$best"
}

# ---- what shape is this secret? ---------------------------------------------
service_of() {
  local d; d=$(detect_provider "$1")
  [[ -n "$d" ]] && { print "$d"; return 0 }
  case "$1" in
    eyJ*.*.*) print jwt ;;
    *) [[ "$1" == 0x[0-9a-fA-F](#c64) || "$1" == [0-9a-fA-F](#c64) ]] && print evm-key || print other ;;
  esac
}
console_of() {
  local i; reg_load
  i=$(reg_idx "$1") && { print -r -- "${REG_URL[$i]}"; return 0 }
  [[ "$1" == jwt ]] && print "https://supabase.com/dashboard/project/_/settings/api-keys" || print ""
}
prefix_hint() {   # "looks like sk-ant-…" — the visual confirmation before pasting
  local i; reg_load
  i=$(reg_idx "$1") || { print ""; return 0 }
  [[ -z "${REG_PRE[$i]}" ]] && { print ""; return 0 }
  local -a ps; ps=( ${(s:,:)REG_PRE[$i]} )   # nested-subscript split yields a CHAR, not an element
  print -r -- "${ps[1]}…"
}

# how a human actually retrieves each key — generated from the registry, so a
# new provider is one table line and needs no prose written for it.
guide_of() {
  local i hint; reg_load
  if [[ "$1" == supabase ]]; then
    print "1. the browser opens at your supabase dashboard → pick the project\n2. Settings → API keys\n3. Reveal + copy the SERVICE_ROLE key — the secret one, NOT anon"
    return 0
  fi
  i=$(reg_idx "$1") || { print "grab the key from your provider's console, then come back"; return 0 }
  hint=$(prefix_hint "$1")
  print "1. the browser opens at ${REG_URL[$i]}\n2. create a new key, or copy one you already have"
  [[ -n "$hint" ]] && print "3. copy the value — it starts with $hint"
}

# ---- the picker: type to filter, arrows to move, Enter to take --------------
# No fzf, no deps, no config — raw zsh against /dev/tty. This IS the product:
# everything behind it is plumbing, but if finding your provider takes more than
# three keystrokes the tool has already lost.
reg_filter() {
  local f="${1:l}" i hay
  for i in $REG_ORDER; do
    [[ -z "$f" ]] && { print "$i"; continue }
    hay="${REG_IDS[$i]:l} ${REG_DISP[$i]:l} ${REG_PRE[$i]:l}"
    [[ "$hay" == *"$f"* ]] && print "$i"
  done
}
in_nest() { grep -qxF "$1" "$IDX" 2>/dev/null }
ref_of()  { local i; reg_load; i=$(reg_idx "$1") && print "$1/${REG_REF[$i]}" || print "$1/API_KEY"; }

PICKED=""
pick_provider() {
  reg_load; PICKED=""
  local tty=/dev/tty
  [[ -r "$tty" && -w "$tty" ]] || { pick_numbered; return $? }
  local stty_save; stty_save=$(stty -g <"$tty" 2>/dev/null) || { pick_numbered; return $? }
  # -isig: Ctrl-C arrives as a byte we handle, so the terminal is ALWAYS restored
  stty -icanon -echo -isig min 1 time 0 <"$tty"
  printf '\e[?25l' >"$tty"

  local filter="" ch rest sel=1 i n shown drawn=0 ret=1 idx mark hint
  local -a rows frame
  while true; do
    rows=( ${(f)"$(reg_filter "$filter")"} )
    n=${#rows}; shown=$(( n > 9 ? 9 : n ))
    (( sel > shown + 1 )) && sel=1
    (( sel < 1 )) && sel=$(( shown + 1 ))

    frame=()
    frame+=( "  which key?   %F{244}type to filter · ↑↓ move · ⏎ take · ^C back%f" )
    frame+=( "  %F{cyan}▸%f ${${filter//\%/%%}}%K{244} %k" )
    # pad the PLAIN text first — colour codes are zero-width, so padding after
    # them lands the columns wherever the escape sequences feel like.
    # NB: zsh expands {1..0} to "1 0", not to nothing — so an empty match list
    # would index rows[0] and abort under `set -u`. Guard, don't assume.
    local namecol hintcol
    (( shown > 0 )) && for i in {1..$shown}; do
      idx=${rows[$i]}
      mark=""; in_nest "$(ref_of "${REG_IDS[$idx]}")" && mark="%F{green}● in nest%f"
      hint=$(prefix_hint "${REG_IDS[$idx]}")
      namecol=$(printf '%-26s' "${REG_DISP[$idx]}")
      hintcol=$(printf '%-14s' "$hint")
      if (( i == sel )); then
        frame+=( "  %F{cyan}❯%f %B${namecol}%b %F{244}${hintcol}%f ${mark}" )
      else
        frame+=( "    ${namecol} %F{244}${hintcol}%f ${mark}" )
      fi
    done
    (( n > shown )) && frame+=( "    %F{244}… $(( n - shown )) more, keep typing%f" )
    (( n == 0 ))    && frame+=( "    %F{244}nothing matches — ⌫ to widen, or take 'custom' below%f" )
    if (( sel == shown + 1 )); then
      frame+=( "  %F{cyan}❯%f %B＋ custom%b %F{244}— name it yourself (anything not listed)%f" )
    else
      frame+=( "    ＋ custom %F{244}— name it yourself (anything not listed)%f" )
    fi

    (( drawn > 0 )) && printf '\e[%dA\e[J' "$drawn" >"$tty"
    for i in {1..${#frame}}; do print -P -- "${frame[$i]}" >"$tty"; done
    drawn=${#frame}

    ch=""; read -k 1 ch <"$tty" || break
    case "$ch" in
      $'\n'|$'\r')
        if (( sel <= shown )); then PICKED="${REG_IDS[${rows[$sel]}]}"; else PICKED="custom"; fi
        ret=0; break ;;
      $'\x03') ret=1; break ;;                      # Ctrl-C
      $'\x7f'|$'\b') filter="${filter%?}"; sel=1 ;; # backspace
      $'\x15') filter=""; sel=1 ;;                  # Ctrl-U
      $'\e')
        rest=""; read -t 0.06 -k 2 rest <"$tty" 2>/dev/null || rest=""
        case "$rest" in
          '[A') (( sel-- )) ;;
          '[B') (( sel++ )) ;;
          '')   ret=1; break ;;                     # bare ESC = back
        esac ;;
      [[:print:]]) filter+="$ch"; sel=1 ;;
    esac
  done

  printf '\e[%dA\e[J\e[?25h' "$drawn" >"$tty"
  stty "$stty_save" <"$tty" 2>/dev/null || true
  [[ $ret -eq 0 && "$PICKED" != custom ]] && reg_bump "$PICKED"
  return $ret
}

# no tty (piped, CI, a weird terminal) — same choices, boring and reliable.
pick_numbered() {
  reg_load; PICKED=""
  local i idx c=0
  print ""
  for i in ${REG_ORDER[1,12]}; do
    c=$((c+1)); printf "    %2d) %-26s %s\n" "$c" "${REG_DISP[$i]}" "$(prefix_hint "${REG_IDS[$i]}")"
  done
  print "     0) something else (name it yourself)"
  print -n "  which key? ▸ "
  local a; read -r a || return 1
  [[ "$a" == 0 ]] && { PICKED=custom; return 0 }
  [[ "$a" == <-> && "$a" -ge 1 && "$a" -le $c ]] || return 1
  PICKED="${REG_IDS[${REG_ORDER[$a]}]}"; reg_bump "$PICKED"; return 0
}

# ---- ask the provider: is this key alive? -----------------------------------
# returns "VERDICT|detail". the whole point of pigeon: a key that exists, parses,
# and is WRONG is the failure that kills agents silently.
probe() {
  local v="$1" verdict="UNKNOWN" detail="no probe for this shape"
  case "$v" in
    sk-or-v1-*)
      local r; r=$(curl -s -m 15 -H "Authorization: Bearer $v" https://openrouter.ai/api/v1/credits 2>/dev/null)
      if [[ "$r" == *'"total_credits"'* ]]; then
        local rem; rem=$(print -r -- "$r" | python3 -c "import sys,json;d=json.load(sys.stdin)['data'];print(f\"{d['total_credits']-d['total_usage']:.2f}\")" 2>/dev/null)
        if [[ "${rem%%.*}" -lt 5 ]] 2>/dev/null; then verdict=LOW; detail="only \$$rem left"; else verdict=ALIVE; detail="\$$rem left"; fi
      else verdict=DEAD; detail="provider rejected it"; fi ;;
    sk-ant-*)
      [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 15 -H "x-api-key: $v" -H 'anthropic-version: 2023-06-01' https://api.anthropic.com/v1/models 2>/dev/null)" == 200 ]] \
        && { verdict=ALIVE; detail=anthropic; } || { verdict=DEAD; detail="anthropic rejected"; } ;;
    sk-proj-*|sk-svcacct-*)
      [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 15 -H "Authorization: Bearer $v" https://api.openai.com/v1/models 2>/dev/null)" == 200 ]] \
        && { verdict=ALIVE; detail=openai; } || { verdict=DEAD; detail="openai rejected"; } ;;
    ghp_*|github_pat_*|gho_*)
      [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 15 -H "Authorization: Bearer $v" https://api.github.com/user 2>/dev/null)" == 200 ]] \
        && { verdict=ALIVE; detail=github; } || { verdict=DEAD; detail="github rejected"; } ;;
    eyJ*.*.*)
      local claims; claims=$(print -r -- "$v" | python3 -c "
import sys,json,base64,time
t=sys.stdin.read().strip().split('.')
b=t[1]+'='*(-len(t[1])%4)
d=json.loads(base64.urlsafe_b64decode(b))
role=d.get('role','?'); exp=d.get('exp')
print(f\"EXPIRED|jwt role={role}, expired\" if exp and exp<time.time() else f\"ALIVE|jwt role={role}\")
" 2>/dev/null)
      [[ -n "$claims" ]] && { verdict="${claims%%|*}"; detail="${claims#*|}"; } ;;
  esac
  print "$verdict|$detail"
}

# ---- gather: the hero verb --------------------------------------------------
# Every place on this machine a key could be hiding. One list, so `gather` and
# the post-paste "where does this already live?" question can never disagree.
# (N) = nullglob per pattern: a machine with no ~/CODE is a valid machine, and
# an unmatched glob must expand to nothing rather than abort the scan.
key_files() {
  local -a f
  f=( $HOME/.zshrc(N) $HOME/.bashrc(N) $HOME/.zshenv(N)
      $HOME/CODE/*/.env(N) $HOME/CODE/*/.env.*(N) $HOME/CODE/*/.env.local(N)
      $HOME/.claude/credentials/*.env(N) )
  f=( ${(u)f} )                                  # .env.local matches two globs
  f=( ${f:#*.bak-pigeon} )                       # never re-read our own backups
  f=( ${f:#*.(example|sample|template)} )        # placeholders are not copies
  print -l -- $f
}
is_shell_profile() { [[ "$1" == $HOME/.zshrc || "$1" == $HOME/.bashrc || "$1" == $HOME/.zshenv ]] }

cmd_gather() {
  c cyan "🐦 gathering keys scattered across this machine…"
  print ""
  local -a files; files=( ${(f)"$(key_files)"} )
  local tmp; tmp=$(mktemp)
  local f line name value svc
  for f in $files; do
    [[ -f "$f" ]] || continue
    # .env.example / .env.sample / .env.template hold placeholders by design.
    # Counting them as real copies invents divergence on a first run — the
    # exact false red that makes a tool feel dumb before it has earned trust.
    [[ "$f" == *.(example|sample|template) ]] && continue
    while IFS= read -r line; do
      [[ "$line" == \#* || "$line" != *=* ]] && continue
      name="${line##*export }"; name="${name%%=*}"; name="${name## }"
      value="${line#*=}"; value="${value//\"/}"; value="${value//\'/}"
      [[ ${#value} -ge 20 && "$name" == *(KEY|TOKEN|SECRET|PASSWORD|DSN)* ]] || continue
      svc=$(service_of "$value")
      print "$svc\t$(fp "$value")\t$name\t${f/#$HOME/~}" >> "$tmp"
    done < "$f"
  done
  [[ -s "$tmp" ]] || { c yellow "no keys found. a tidy nest, or an empty one."; rm -f "$tmp"; return 0; }

  local svc_list; svc_list=$(cut -f1 "$tmp" | sort -u)
  local total; total=$(wc -l < "$tmp" | tr -d ' ')
  local services; services=$(print -r -- "$svc_list" | grep -c . )
  # Divergence only ALARMS for account-scoped keys — one account, so every copy
  # should be byte-identical. Per-project keys (a Vercel OIDC token, a Supabase
  # anon key, an EVM wallet key) are SUPPOSED to differ; flagging them is the
  # kind of false red that makes a tool feel dumb on first run.
  local account_scoped=" openrouter anthropic openai github "
  local divergent=0 s n_fp
  while IFS= read -r s; do
    [[ -z "$s" ]] && continue
    n_fp=$(awk -F'\t' -v s="$s" '$1==s{print $2}' "$tmp" | sort -u | grep -c .)
    if [[ "$n_fp" -gt 1 && "$account_scoped" == *" $s "* ]]; then
      c red "  ▲ $s — $n_fp DIFFERENT values for ONE account. one of these is stale."
      divergent=$((divergent+1))
      awk -F'\t' -v s="$s" '$1==s{printf "      %s  %-30s %s\n",$2,$3,$4}' "$tmp" | sort -u
    elif [[ "$s" == other ]]; then
      c green "  ✓ ${n_fp} other service keys (okx, xai, twitter, wallets, …)"
    else
      c green "  ✓ $s (${n_fp} distinct)"
    fi
  done <<< "$svc_list"
  print ""
  c cyan "  $total keys · $services services · $divergent account-key(s) diverged"
  [[ $divergent -gt 0 ]] && c red "  a diverged account key means one copy is stale — that's how an agent dies quiet." \
                          || c green "  no account key has a stale copy. tidy nest."

  print ""
  if [[ $divergent -gt 0 ]]; then
    c 244 "  to fix a diverged key: run \`$SELF\`, pick it, paste the good value once —"
    c 244 "  pigeon will offer to overwrite every stale copy it just listed."
  else
    c 244 "  run \`$SELF check\` to see which of these are already dead."
  fi
  rm -f "$tmp"
}

# ---- check: the tweet ----------------------------------------------------
cmd_check() {
  # --json makes this callable by the fleet it was built for: no colour, no
  # prose, no values — refs, verdicts and fingerprints only.
  local want="" json=0 a
  for a in "$@"; do
    case "$a" in --json) json=1 ;; *) want="$a" ;; esac
  done
  # An empty nest is a new user, not an error. `die` calls exit, so dying here
  # tore down the whole wizard from inside `cmd_check || true` — the first thing
  # a first-time user hit if they picked "check" before storing anything.
  if [[ ! -s "$IDX" ]]; then
    (( json )) && { print '{"alive":0,"dead":0,"unverified":0,"keys":[]}'; return 0 }
    c yellow "the nest is empty — nothing to check yet."
    print "  set up your first key: run \`$SELF\` and pick 1, or \`$SELF stash openrouter/API_KEY\`"
    return 0
  fi
  (( json )) || { c cyan "🐦 asking each provider if the key still works…"; print "" }
  local alive=0 dead=0 unknown=0 ref v res verdict detail color
  local rows; rows=$(mktemp)
  while IFS= read -r ref; do
    [[ -z "$ref" ]] && continue
    [[ -n "$want" && "$ref" != $want* ]] && continue
    if ! v=$(kc_get "$ref"); then
      dead=$((dead+1)); print "$ref\tMISSING\tindexed, not in keychain\t-" >> "$rows"
      (( json )) || { printf "  %-30s " "$ref"; c red "MISSING (indexed, not in keychain)"; }
      continue
    fi
    res=$(probe "$v"); verdict="${res%%|*}"; detail="${res#*|}"
    case "$verdict" in
      ALIVE) color=green; alive=$((alive+1)) ;;
      LOW)   color=yellow; alive=$((alive+1)) ;;
      DEAD|EXPIRED) color=red; dead=$((dead+1)) ;;
      *) color=244; unknown=$((unknown+1)) ;;
    esac
    print "$ref\t$verdict\t$detail\t$(fp "$v")" >> "$rows"
    (( json )) || { printf "  %-30s " "$ref"; print -P "%F{$color}${(r:8:)verdict}%f $detail"; }
  done < "$IDX"
  if (( json )); then
    A=$alive D=$dead U=$unknown python3 -c "
import sys, json, os
keys = []
for line in open(sys.argv[1]):
    p = line.rstrip('\n').split('\t')
    if len(p) == 4:
        keys.append({'ref': p[0], 'verdict': p[1], 'detail': p[2], 'fingerprint': p[3]})
print(json.dumps({'alive': int(os.environ['A']), 'dead': int(os.environ['D']),
                  'unverified': int(os.environ['U']), 'keys': keys}, indent=2))" "$rows"
    rm -f "$rows"
    (( dead > 0 )) && return 1 || return 0
  fi
  rm -f "$rows"
  print ""
  c cyan "  $alive alive · $dead dead · $unknown unverified"
  # Exit status is the contract for `watch`/CI: 0 = nothing dead, 1 = act now.
  # It used to be inverted — the trailing `[[ $dead -gt 0 ]] &&` was the last
  # command, so a perfectly healthy nest made `coo check` exit 1.
  if (( dead > 0 )); then
    c red "  a dead key that still sits in a config is an agent that fails silently."
    return 1
  fi
  return 0
}

cmd_nest() {
  if [[ "${1:-}" == "--json" ]]; then
    python3 -c "
import sys, json
print(json.dumps([l.strip() for l in open(sys.argv[1]) if l.strip()], indent=2))" "$IDX"
    return 0
  fi
  [[ -s "$IDX" ]] && { c cyan "🐦 the nest:"; sed 's/^/  /' "$IDX"; } || c yellow "the nest is empty."
}
cmd_stash() {
  local ref="${1:-}"; [[ -n "$ref" ]] || die "usage: $SELF stash <service/NAME> [--stdin]"
  local v
  if [[ "${2:-}" == "--stdin" || ! -t 0 ]]; then
    # the agent path: `printf '%s' "$KEY" | coo stash openrouter/API_KEY --stdin`
    IFS= read -r v || true
  else
    print -n "paste value for $ref (hidden): "; read -rs v; print ""
  fi
  [[ -n "$v" ]] || die "empty, nothing stashed"
  kc_set "$ref" "$v"; idx_add "$ref"
  c green "✓ stashed $ref ($(fp "$v"), ${#v} chars)"
  [[ "$v" == *.*.* ]] && print -r -- "$v" | python3 -c "import sys,json,base64;t=sys.stdin.read().strip().split('.');b=t[1]+'='*(-len(t[1])%4);print('  jwt role:',json.loads(base64.urlsafe_b64decode(b)).get('role','?'))" 2>/dev/null || true
}

# ---- where does this key ALREADY live? --------------------------------------
# The bug that started pigeon: you copy a key to four places, one gets revoked,
# an agent dies quiet. So the moment a fresh value is verified, we go looking for
# the stale copies — by VALUE SHAPE, not by variable name, because the fourth
# copy is always the one someone called `OR_KEY` at 2am.
value_is_provider() {
  local i p; i=$(reg_idx "$2") || return 1
  [[ -z "${REG_PRE[$i]}" ]] && return 1
  for p in ${(s:,:)REG_PRE[$i]}; do [[ "$1" == "$p"* ]] && return 0; done
  return 1
}
sites_paths() {
  SITES_F="$SITES" REF="$1" python3 -c "
import json,os
d = json.load(open(os.environ['SITES_F']))
for x in d.get(os.environ['REF'], []):
    if x.get('type') != 'vercel': print(x['path'])" 2>/dev/null || true
}
find_existing_homes() {   # -> path \t VAR \t same|stale \t fingerprint
  # NB: `local a="$1" b="${a%%/*}"` reads the CALLER's `a`, silently, with no
  # error when one exists. Derive on a separate line, always.
  local ref="$1" can="$2"
  local id="${ref%%/*}" refname="${ref#*/}"
  local i envvar=""; i=$(reg_idx "$id") && envvar="${REG_ENV[$i]}"
  local f line name value hit
  for f in ${(f)"$(key_files)"}; do
    [[ -f "$f" && -r "$f" ]] || continue
    [[ "$f" == *.(example|sample|template) ]] && continue
    while IFS= read -r line; do
      [[ "$line" == \#* || "$line" != *=* ]] && continue
      name="${line##*export }"; name="${name%%=*}"; name="${name//[[:space:]]/}"
      value="${line#*=}"; value="${value//\"/}"; value="${value//\'/}"
      [[ ${#value} -ge 20 && -n "$name" ]] || continue
      hit=0
      if value_is_provider "$value" "$id"; then
        [[ "$(detect_provider "$value")" == "$id" ]] && hit=1     # resolve prefix collisions
      fi
      [[ -n "$envvar" && "$name" == "$envvar" ]] && hit=1
      [[ "$name" == "$refname" ]] && hit=1
      (( hit )) || continue
      if [[ "$value" == "$can" ]]; then print "$f\t$name\tsame\t$(fp "$value")"
      else                              print "$f\t$name\tstale\t$(fp "$value")"; fi
    done < "$f"
  done
}

# ---- land it: the whole point. a paste that ends in the right files. --------
land_it() {
  local ref="$1" can="$2"
  local id="${ref%%/*}"
  local i envvar=""; i=$(reg_idx "$id") && envvar="${REG_ENV[$i]}"

  # 1. homes you already declared are not a question — just deliver.
  local declared n_sites
  declared=$(sites_paths "$ref")
  n_sites=$(print -r -- "$declared" | grep -c . || true)
  (( n_sites > 0 )) && { print ""; cmd_fan "$ref" || true; }

  # 2. homes we can SEE but you never declared.
  local homes
  homes=$(find_existing_homes "$ref" "$can" | sort -u)
  if [[ -n "$declared" ]]; then
    homes=$(print -r -- "$homes" | grep -vF -f <(print -r -- "$declared") || true)
  fi
  local -a hp hv hs hf
  local p n s g
  while IFS=$'\t' read -r p n s g; do
    [[ -z "$p" ]] && continue
    hp+=("$p"); hv+=("$n"); hs+=("$s"); hf+=("$g")
  done <<< "$homes"

  local stale=0
  (( ${#hp} > 0 )) && for i in {1..${#hp}}; do
    [[ "${hs[$i]}" == stale ]] && ! is_shell_profile "${hp[$i]}" && (( ++stale ))
  done

  if (( ${#hp} > 0 )); then
    print ""; c cyan "🐦 this key already lives in ${#hp} place(s) on this machine:"
    for i in {1..${#hp}}; do
      local tag warn=""
      is_shell_profile "${hp[$i]}" && warn=" %F{yellow}⚠ shell profile%f"
      if [[ "${hs[$i]}" == same ]]; then tag="%F{green}already correct%f"
      else tag="%F{red}stale (${hf[$i]})%f"; fi
      print -P -- "     $(printf '%2d' $i)  $(printf '%-34s %-26s' "${hp[$i]/#$HOME/~}" "${hv[$i]}") $tag$warn"
    done
  fi

  # non-interactive: report, never act.
  if [[ ! -t 0 ]]; then
    (( stale > 0 )) && c yellow "  $stale stale copy(ies) left alone — run \`$SELF\` in a terminal to overwrite them."
    return 0
  fi

  local ans j
  if (( stale > 0 )); then
    print ""
    print -n "  overwrite the $stale stale copy(ies) with what you just pasted? [Y/n/p=pick] ▸ "
    read -r ans || ans=""
    case "${ans:l}" in
      n*) c 244 "  left alone. they will keep failing until something rewrites them." ;;
      p*) for i in {1..${#hp}}; do
            [[ "${hs[$i]}" == same ]] && continue
            print -n "     ${hp[$i]/#$HOME/~} (${hv[$i]}) ? [y/N] ▸ "
            read -r ans || ans=""
            [[ "${ans:l}" == y* ]] && cmd_site "$ref" "${hp[$i]}" "${hv[$i]}" >/dev/null
          done
          cmd_fan "$ref" || true ;;
      *)  for i in {1..${#hp}}; do
            [[ "${hs[$i]}" == same ]] && continue
            # a shell profile is a bigger deal than a .env — never bulk-write one.
            is_shell_profile "${hp[$i]}" && { c 244 "     skipped ${hp[$i]/#$HOME/~} (shell profile — use p to include it)"; continue }
            cmd_site "$ref" "${hp[$i]}" "${hv[$i]}" >/dev/null
          done
          cmd_fan "$ref" || true ;;
    esac
  fi

  # 3. a home it does not have yet.
  print ""
  if (( ${#hp} == 0 && n_sites == 0 )); then
    c 244 "  nothing on this machine holds a $id key yet."
    print -n "  which file should hold it? (path, or Enter to keep it nest-only) ▸ "
  else
    print -n "  any other file that should hold it? (path, or Enter to finish) ▸ "
  fi
  local np nv
  read -r np || np=""
  [[ -z "$np" ]] && { c green "  ✓ done — $ref is in your nest$( (( ${#hp} + n_sites > 0 )) && print -n " and its files")."; return 0 }
  np="${np/#\~/$HOME}"
  print -n "  variable name in that file${envvar:+ [$envvar]} ▸ "
  read -r nv || nv=""
  [[ -z "$nv" ]] && nv="$envvar"
  [[ -z "$nv" ]] && { c yellow "  no variable name — skipped."; return 0 }
  [[ -f "$np" ]] || { c yellow "  $np does not exist yet — creating it."; : > "$np"; }
  cmd_site "$ref" "$np" "$nv" >/dev/null
  cmd_fan "$ref" || true
  c green "  ✓ done — pasted once, landed everywhere."
  return 0
}

# ---- paste_and_land: one guided paste, verified, delivered everywhere -------
paste_and_land() {
  local ref="$1" svc="${1%%/*}"
  local url; url=$(console_of "$svc")
  print ""; c cyan "  $svc — how to grab it:"
  guide_of "$svc" | sed 's/^/    /'
  if [[ -n "$url" && -z "${COO_TEST:-}" ]]; then
    open "$url" >/dev/null 2>&1 || true
    c 244 "    (browser opened: $url)"
  fi
  print -n "  paste it here (hidden, Enter to cancel) ▸ "
  local v; read -rs v || true; print ""
  [[ -z "$v" ]] && { c 244 "  cancelled — nothing stored."; return 1; }

  # The registry generalises the supabase wrong-row trap to every provider: if
  # the value's prefix names a DIFFERENT vendor than the one you picked, you
  # almost certainly copied the wrong row of the wrong dashboard.
  local seen ans seen_i seen_name; seen=$(detect_provider "$v")
  if [[ -n "$seen" && "$seen" != "$svc" ]]; then
    seen_name="$seen"; seen_i=$(reg_idx "$seen") && seen_name="${REG_DISP[$seen_i]}"
    if reg_idx "$svc" >/dev/null 2>&1; then
      # you picked a known provider and pasted a different one's key — that is
      # the wrong-dashboard-row mistake, and it deserves a hard stop.
      c yellow "  ⚠ that looks like a $seen_name key ($(prefix_hint "$seen")), not $svc."
      print -n "     store it as $ref anyway? [y/N] ▸ "
      read -r ans || ans=""
      [[ "$ans" == [yY]* ]] || { c 244 "  nothing stored. grab the right row and run coo again."; return 1 }
    else
      # you named this yourself, so you meant it — just say what we can see.
      c 244 "  (looks like a $seen_name key — storing it as $ref, your name wins.)"
    fi
  fi

  # supabase wants the SERVICE_ROLE key specifically; catch the classic wrong-row copy.
  if [[ "$ref" == supabase/* && "$v" == eyJ*.*.* ]]; then
    local role
    role=$(print -r -- "$v" | python3 -c "import sys,json,base64;t=sys.stdin.read().strip().split('.');b=t[1]+'='*(-len(t[1])%4);print(json.loads(base64.urlsafe_b64decode(b)).get('role','?'))" 2>/dev/null || print "?")
    if [[ "$role" != "service_role" ]]; then
      c red "  ✗ that's the '$role' key — the wrong row. we need SERVICE_ROLE (marked secret). not stored."
      return 1
    fi
    c green "  ✓ jwt role: service_role — the right one."
  fi

  local res verdict detail; res=$(probe "$v"); verdict="${res%%|*}"; detail="${res#*|}"
  case "$verdict" in
    DEAD|EXPIRED) c red "  ✗ the provider rejects that key ($detail). not stored — grab a fresh one and retry."; return 1 ;;
    ALIVE|LOW)    c green "  ✓ verified live with the provider: $detail" ;;
    *)            c 244 "  no live probe for this shape yet — storing it as-is ($(fp "$v"), ${#v} chars)" ;;
  esac

  kc_set "$ref" "$v"; idx_add "$ref"
  c green "  ✓ stashed $ref"
  land_it "$ref" "$v"
  return 0
}

# ---- rotate / remove --------------------------------------------------------
cmd_rotate() {
  local ref="${1:-}"; [[ -n "$ref" ]] || die "usage: $SELF rotate <service/NAME>"
  local old oldfp="nothing stored yet"
  old=$(kc_get "$ref" 2>/dev/null || true); [[ -n "$old" ]] && oldfp=$(fp "$old")
  c cyan "🐦 rotating $ref — the value in the nest right now is $oldfp"
  paste_and_land "$ref" || return 1
  local url; url=$(console_of "${ref%%/*}")
  print ""
  c yellow "  one step left, and only you can do it: REVOKE the old key ($oldfp)."
  [[ -n "$url" ]] && print "    $url"
  c 244 "  pigeon deliberately never revokes for you — a wrong guess there takes prod down."
  return 0
}

cmd_remove() {
  local ref="${1:-}"; [[ -n "$ref" ]] || die "usage: $SELF remove <service/NAME>"
  in_nest "$ref" || { c yellow "  $ref is not in the nest."; return 0 }
  print -n "  remove $ref? the value is deleted from your keychain. [y/N] ▸ "
  local a; read -r a || a=""
  [[ "$a" == [yY]* ]] || { c 244 "  left alone."; return 0 }
  security delete-generic-password -s "$SERVICE" -a "$ref" >/dev/null 2>&1 || true
  local tmp; tmp=$(mktemp); grep -vxF "$ref" "$IDX" > "$tmp" 2>/dev/null || : > "$tmp"; mv "$tmp" "$IDX"
  c green "  ✓ removed $ref from the nest"
  c 244 "  note: any file that already holds this value still holds it — pigeon does not reach back in."
}

# ---- one key, every verb, no memorising -------------------------------------
key_actions() {
  local ref="$1" id="${1%%/*}" a sp sv2 def i
  while true; do
    print ""
    c cyan "  $ref — already in the nest"
    print "    r) rotate   paste a new value, verify it live, push it everywhere"
    print "    c) check    ask the provider right now: alive, dead, drained?"
    print "    f) fan      push the stored value to its declared homes"
    print "    s) site     declare another file + variable this key must live in"
    print "    d) delete   remove it from the nest"
    print "    b) back"
    print -n "  ▸ "
    read -r a || return 0
    case "$a" in
      r) cmd_rotate "$ref" || true; return 0 ;;
      c) print ""; cmd_check "$ref" || true ;;
      f) print ""; cmd_fan "$ref" || true ;;
      s) print -n "  which file must hold it? ▸ "; read -r sp || continue
         def=""; i=$(reg_idx "$id") && def="${REG_ENV[$i]}"
         print -n "  variable name in that file${def:+ [$def]} ▸ "; read -r sv2 || continue
         [[ -z "$sv2" ]] && sv2="$def"
         if [[ -n "$sp" && -n "$sv2" ]]; then cmd_site "$ref" "$sp" "$sv2" || true; else c 244 "  skipped."; fi ;;
      d) cmd_remove "$ref" || true; return 0 ;;
      b|B|"") return 0 ;;
      *) c 244 "  r, c, f, s, d or b." ;;
    esac
  done
}

key_flow() {
  pick_provider || return 0
  local id="$PICKED" ref
  if [[ "$id" == custom ]]; then
    print ""
    print "  name it. \"service/NAME\" — the service groups it, the NAME is yours."
    print -n "  e.g. stripe/WEBHOOK_SECRET ▸ "
    read -r ref || return 0
    [[ -n "$ref" ]] || { c 244 "  nothing named."; return 0 }
    [[ "$ref" == */* ]] || ref="custom/$ref"
  else
    ref=$(ref_of "$id")
  fi
  if in_nest "$ref"; then key_actions "$ref"; else paste_and_land "$ref" || true; fi
}

# ---- the wizard: what bare `coo` runs. zero args, zero memorizing. -----------
cmd_wizard() {
  if [[ ! -t 0 && -z "${COO_TEST:-}" ]]; then
    c cyan "🐦 hi. run \`coo\` in a real terminal for the guided flow."
    print "  or use verbs directly: coo gather · coo check · coo stash <ref> · coo help"
    return 0
  fi
  c cyan "🐦 pigeon — let's sort your keys."

  # unfinished business first: a declared home with no key in the nest.
  local -a pending; local sref
  while IFS= read -r sref; do
    [[ -z "$sref" ]] && continue
    kc_get "$sref" >/dev/null 2>&1 || pending+=("$sref")
  done <<< "$(python3 -c "import json,sys;print('\n'.join(json.load(open(sys.argv[1])).keys()))" "$SITES" 2>/dev/null || true)"
  if (( ${#pending} > 0 )); then
    print ""; c yellow "  unfinished setup: ${pending[1]} (a home is declared, the key is missing)"
    print -n "  press Enter to finish it now, or m for the menu ▸ "
    local a; read -r a || true
    if [[ -z "$a" ]]; then
      paste_and_land "${pending[1]}" && return 0
    fi
  fi

  local choice p ref   # hoisted: re-declaring these each pass echoed them back
  while true; do
    print ""
    print "  what do you want to do?"
    print "    1) add or fix a key   pick from 60 providers, paste once, it lands in every file"
    print "    2) check my keys      ask each provider: alive, dead, drained?"
    print "    3) find keys          scan this machine for scattered and stale copies"
    print "    q) quit"
    print -n "  ▸ "
    read -r choice || return 0
    case "$choice" in
      1) key_flow || true ;;
      2) print ""; cmd_check || true ;;
      3) print ""; cmd_gather || true ;;
      q|Q|"") return 0 ;;
      *) c 244 "  1, 2, 3 or q." ;;
    esac
  done
}

# ---- install: one time, then `coo` works from anywhere ----------------------
cmd_install() {
  local bin="$HOME/.local/bin"; mkdir -p "$bin"
  ln -sf "$SELF_PATH" "$bin/coo"
  c green "✓ installed: $bin/coo → $SELF_PATH"
  case ":$PATH:" in
    *":$bin:"*) c cyan "  done. type \`coo\` from anywhere — that's the whole guide." ;;
    *) c yellow "  one more step — $bin is not on your PATH. run:"
       print "    echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.zshrc && exec zsh" ;;
  esac
}

# ---- setup: ONE command, a smooth guided paste flow ------------------------
# the whole product in one verb. you run `coo`, it tells you what's broken,
# and walks you through pasting fresh keys — verifying each one live before it
# stores it. no AI (you have no keys yet to run one), no dashboard, no account.
cmd_setup() {
  c cyan "🐦 hi. let's sort out your keys."; print ""
  if [[ ! -t 0 ]]; then
    c yellow "  (this is an interactive flow — run \`coo\` in a real terminal.)"
    print "  or use the verbs directly: coo gather · coo check · coo stash <ref>"
    return 0
  fi

  print "  scanning your machine…"
  local tmp; tmp=$(mktemp)
  local f line name value svc
  for f in $HOME/.zshrc $HOME/CODE/*/.env $HOME/CODE/*/.env.local $HOME/.claude/credentials/*.env; do
    [[ -f "$f" ]] || continue
    while IFS= read -r line; do
      [[ "$line" == \#* || "$line" != *=* ]] && continue
      name="${line##*export }"; name="${name%%=*}"; name="${name## }"
      value="${line#*=}"; value="${value//\"/}"; value="${value//\'/}"
      [[ ${#value} -ge 20 && "$name" == *(KEY|TOKEN|SECRET)* ]] || continue
      svc=$(service_of "$value")
      print "$svc\t$value" >> "$tmp"
    done < "$f"
  done

  # For each service we know how to probe, show its current state, then offer a
  # fresh paste for anything DEAD / LOW / not yet in the nest.
  local -a services; services=(openrouter anthropic openai github supabase)
  print ""; c cyan "  here's what I found:"; print ""
  # `stored` and `vres` MUST be declared here, not inside the loop: a re-declared
  # local echoes its current value, and `stored` holds a live API key.
  local s val res verdict detail fresh stored vres vv
  for s in $services; do
    val=$(awk -F'\t' -v s="$s" '$1==s{print $2; exit}' "$tmp")
    stored=$(kc_get "$s/API_KEY" 2>/dev/null || true)
    [[ -z "$val" && -n "$stored" ]] && val="$stored"

    if [[ -z "$val" ]]; then
      printf "  %-12s " "$s"; c 244 "not found"
      continue
    fi
    res=$(probe "$val"); verdict="${res%%|*}"; detail="${res#*|}"
    case "$verdict" in
      ALIVE) printf "  %-12s " "$s"; print -P "%F{green}ALIVE%f  $detail"; continue ;;
      LOW)   printf "  %-12s " "$s"; print -P "%F{yellow}LOW%f    $detail — worth replacing" ;;
      DEAD|EXPIRED) printf "  %-12s " "$s"; print -P "%F{red}DEAD%f   $detail" ;;
      *)     printf "  %-12s " "$s"; print -P "%F{green}$verdict%f $detail"; continue ;;
    esac

    # broken → guided paste
    print -n "  └─ paste a fresh $s key here (hidden, or Enter to skip) ▸ "
    read -rs fresh; print ""
    [[ -z "$fresh" ]] && { c 244 "     skipped."; continue; }
    vres=$(probe "$fresh"); vv="${vres%%|*}"
    if [[ "$vv" == DEAD || "$vv" == EXPIRED ]]; then
      c red "     that one's also rejected by the provider — not stored. try again with \`coo stash $s/API_KEY\`."
      continue
    fi
    kc_set "$s/API_KEY" "$fresh"; idx_add "$s/API_KEY"
    c green "     ✓ verified (${vres#*|}) and gathered into the nest."
  done
  rm -f "$tmp"

  # ---- pending sites: any key with a declared home gets FINISHED right here.
  # this is the piece that makes `coo` the whole guide: if a site was declared
  # (by you, or an agent setting up a task), the flow ends with the key landed —
  # never with "now go run two more commands."
  local site_refs
  site_refs=$(python3 -c "import json,sys;print('\n'.join(json.load(open(sys.argv[1])).keys()))" "$SITES" 2>/dev/null || true)
  if [[ -n "$site_refs" ]]; then
    print ""; c cyan "  keys with declared homes:"
    local sref sv surl ans
    while IFS= read -r sref; do
      [[ -z "$sref" ]] && continue
      if kc_get "$sref" >/dev/null 2>&1; then
        # Never fan an already-stored key unasked. A declared site can be a
        # Vercel production env; pushing whatever happens to sit in the nest
        # (including a stale or placeholder value) is not a diagnostic.
        print -n "  $sref already in the nest — push it to its declared homes? [y/N] ▸ "
        read -r ans || ans=""
        if [[ "$ans" == [yY]* ]]; then cmd_fan "$sref" || true
        else c 244 "     left alone."; fi
      else
        c yellow "  $sref has a declared home but no key in the nest yet."
        surl=$(console_of "${sref%%/*}")
        [[ -n "$surl" ]] && { c 244 "     opening where it lives: $surl"; open "$surl" >/dev/null 2>&1 || true; }
        print -n "  └─ paste it now (hidden, or Enter to skip) ▸ "
        read -rs sv; print ""
        if [[ -z "$sv" ]]; then c 244 "     skipped."; continue; fi
        kc_set "$sref" "$sv"; idx_add "$sref"
        c green "     ✓ stashed $sref ($(fp "$sv"), ${#sv} chars)"
        [[ "$sv" == *.*.* ]] && print -r -- "$sv" | python3 -c "import sys,json,base64;t=sys.stdin.read().strip().split('.');b=t[1]+'='*(-len(t[1])%4);print('     jwt role:',json.loads(base64.urlsafe_b64decode(b)).get('role','?'))" 2>/dev/null || true
        cmd_fan "$sref" || true
      fi
    done <<< "$site_refs"
  fi

  print ""; c cyan "🐦 your nest:"
  cmd_check 2>/dev/null || true
  print ""; c 244 "  run \`coo\` anytime to re-check, or \`coo fan <ref>\` to push a key everywhere it lives."
}

# ---- fan: one paste → every place a key lives -------------------------------
# the copy-paste killer. declare where a key lives once, then `coo fan <ref>`
# writes the canonical nest value to every declared .env, backing up what it
# replaced. this is the fix for the bug that started pigeon: four copies, one
# goes stale, an agent dies quiet. values are never printed — only fingerprints.
cmd_site() {
  local ref="${1:-}"
  if [[ "${2:-}" == "--vercel" ]]; then
    local cwd="${3:-}" var="${4:-}" env="${5:-production}"
    [[ -n "$ref" && -n "$cwd" && -n "$var" ]] \
      || die "usage: $SELF site <service/NAME> --vercel <project-dir> <VAR_NAME> [environment]"
    SITES_F="$SITES" REF="$ref" P="${cwd/#\~/$HOME}" V="$var" E="$env" python3 - <<'PY'
import json, os
f = os.environ['SITES_F']; d = json.load(open(f))
entry = {"type": "vercel", "cwd": os.environ['P'], "var": os.environ['V'], "env": os.environ['E']}
lst = d.setdefault(os.environ['REF'], [])
if entry not in lst: lst.append(entry)
json.dump(d, open(f, 'w'), indent=2)
print(f"declared: {os.environ['REF']} → vercel {os.environ['E']} ({os.environ['V']}, project {os.environ['P']})")
PY
    return 0
  fi
  local target="${2:-}" var="${3:-}"   # never name a local `path` in zsh
  [[ -n "$ref" && -n "$target" && -n "$var" ]] \
    || die "usage: $SELF site <service/NAME> <file-path> <VAR_NAME>"
  SITES_F="$SITES" REF="$ref" P="${target/#\~/$HOME}" V="$var" python3 - <<'PY'
import json, os
f = os.environ['SITES_F']; d = json.load(open(f))
entry = {"path": os.environ['P'], "var": os.environ['V']}
lst = d.setdefault(os.environ['REF'], [])
if entry not in lst: lst.append(entry)
json.dump(d, open(f, 'w'), indent=2)
print(f"declared: {os.environ['REF']} → {os.environ['P']} ({os.environ['V']})")
PY
}

cmd_fan() {
  local ref="${1:-}"
  [[ -n "$ref" ]] || die "usage: $SELF fan <service/NAME>   (declare sites first: $SELF site …)"
  local can; can=$(kc_get "$ref") || die "no key stored for $ref — stash it first: $SELF stash $ref"

  c cyan "🐦 fanning $ref ($(fp "$can")) to every declared site…"; print ""
  local wrote=0 same=0 miss=0
  # show the plan + drift, then write. python does the file edits atomically-ish
  # (write to a temp, back up the original, move) and reports one line per site.
  local report
  report=$(SITES_F="$SITES" REF="$ref" CAN="$can" python3 - <<'PY'
import json, os, shutil, hashlib, sys
d = json.load(open(os.environ['SITES_F'])); ref = os.environ['REF']; can = os.environ['CAN']
def fp(v): return hashlib.sha1(v.encode()).hexdigest()[:8]
sites = [x for x in d.get(ref, []) if x.get('type') != 'vercel']
if not sites:
    print("NOSITES"); sys.exit(0)
w=s=m=0
for site in sites:
    p, var = site['path'], site['var']
    try:
        lines = open(p).readlines()
    except OSError:
        print(f"MISS\t{p}\t{var} (file unreadable)"); m+=1; continue
    out, found, changed = [], False, False
    for line in lines:
        ls = line.strip(); bare = ls.replace('export ', '', 1)
        if not ls.startswith('#') and bare.startswith(var + '='):
            found = True
            old = bare.split('=', 1)[1].strip().strip('"').strip("'")
            if old == can:
                out.append(line)
            else:
                pre = 'export ' if ls.startswith('export ') else ''
                ind = line[:len(line)-len(line.lstrip())]
                out.append(f'{ind}{pre}{var}={can}\n'); changed = True
                print(f"WROTE\t{p}\t{fp(old)} → {fp(can)}")
        else:
            out.append(line)
    if not found:
        out.append(f'{var}={can}\n'); changed = True
        print(f"WROTE\t{p}\t(added {var})")
    if changed:
        shutil.copy2(p, p + '.bak-pigeon')     # always reversible
        open(p, 'w').writelines(out); w+=1
    elif found:
        print(f"SAME\t{p}\talready canonical"); s+=1
print(f"TALLY\t{w}\t{s}\t{m}")
PY
)
  local had_files=1
  if [[ "$report" == "NOSITES" ]]; then
    had_files=0
  else
    local kind a b extra
    while IFS=$'\t' read -r kind a b extra; do
      case "$kind" in
        WROTE) c green  "  ✓ ${a/#$HOME/~}  $b" ;;
        SAME)  c 244    "  · ${a/#$HOME/~}  $b" ;;
        MISS)  c yellow "  ⚠ ${a/#$HOME/~}  $b" ;;
        TALLY) print ""; c cyan "  $a written · $b already-canonical · $extra unreachable"
               [[ "$a" -gt 0 ]] && c 244 "  each changed file backed up as <file>.bak-pigeon" ;;
      esac
    done <<< "$report"
  fi

  # vercel sites: pipe the value straight into `vercel env`, never through a
  # human's clipboard twice. rm-then-add because add alone refuses duplicates.
  local vsites
  vsites=$(SITES_F="$SITES" REF="$ref" python3 -c "
import json, os
d = json.load(open(os.environ['SITES_F']))
for x in d.get(os.environ['REF'], []):
    if x.get('type') == 'vercel':
        print(f\"{x['cwd']}\t{x['var']}\t{x.get('env','production')}\")" 2>/dev/null || true)
  if [[ -n "$vsites" ]]; then
    local vcwd vvar venv
    while IFS=$'\t' read -r vcwd vvar venv; do
      [[ -z "$vcwd" ]] && continue
      c cyan "  vercel: $vvar → $venv (${vcwd/#$HOME/~})…"
      if (cd "$vcwd" && { npx vercel env rm "$vvar" "$venv" --yes >/dev/null 2>&1 || true; } \
            && printf '%s' "$can" | npx vercel env add "$vvar" "$venv" >/dev/null 2>&1); then
        c green "  ✓ vercel env $vvar ($venv) updated — redeploy to make it live"
      else
        c red "  ✗ vercel update failed. manual: cd ${vcwd/#$HOME/~} && npx vercel env add $vvar $venv"
      fi
    done <<< "$vsites"
  elif [[ $had_files -eq 0 ]]; then
    c yellow "  no sites declared for $ref."
    print "  declare one:  $SELF site $ref ~/CODE/yourproj/.env OPENROUTER_API_KEY"
  fi
}

# Load the registry in the MAIN shell. Every helper calls reg_load defensively,
# but most are invoked as $(...) — so their arrays died with the subshell and the
# parent still saw an empty registry. Load once, here, and it is always there.
reg_load

case "${1:-}" in
  ""|setup) cmd_wizard ;;
  doctor)   cmd_setup ;;
  install)  cmd_install ;;
  gather)   shift; cmd_gather "$@" ;;
  check)    shift; cmd_check  "$@" ;;
  nest)     shift; cmd_nest   "$@" ;;
  stash)    shift; cmd_stash  "$@" ;;
  rotate)   shift; cmd_rotate "$@" ;;
  remove|rm) shift; cmd_remove "$@" ;;
  site)     shift; cmd_site   "$@" ;;
  fan)      shift; cmd_fan    "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $1 (try \`$SELF help\`)" ;;
esac
