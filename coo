#!/bin/zsh
# pigeon — carrier pigeon for your API keys. gather them, check them, keep them alive.
#
#   coo gather   scan the machine, find every scattered key, show divergence
#   coo check    ask each provider: alive? dead? drained? wrong role?
#   coo nest     list what's gathered (names only, never values)
#   coo fan      push the canonical value to every place a key should live
#
# storage is a solved problem (1Password, SOPS, age). pigeon does NOT reinvent a
# vault. it does the thing none of them do: keep a heterogeneous AGENT FLEET's
# keys alive — across repos, a VPS, Vercel, and each agent's own auth store.
#
# free. local. no server, no account, no per-seat fee. values never leave the
# machine and are never printed. mac-first for v0.1; portable backend is roadmap.
#
# MIT. https://github.com/Morkeeth/pigeon

set -euo pipefail
SERVICE="pigeon-nest"
SELF="${0:t}"
SELF_PATH="${0:A}"   # resolved at top level, where $0 is the script — inside a function zsh makes $0 the function name
NEST="${XDG_DATA_HOME:-$HOME/.local/share}/pigeon"
mkdir -p "$NEST"
SITES="$NEST/sites.json"; [[ -f "$SITES" ]] || print '{}' > "$SITES"

c()   { print -P "%F{$1}$2%f"; }
die() { print -u2 "✗ $*"; exit 1; }
fp()  { printf '%s' "$1" | shasum | cut -c1-8; }   # identity, never exposure

usage() {
  cat <<'EOF'
🐦 pigeon — gather, check and rotate API keys across your agent fleet

  coo                      the whole guide: scans, checks, walks you through fixes
  coo install              put coo on your PATH (run once, then just type coo)
  coo gather [--collect]   find every key on this machine; --collect stores them
  coo check [service]      ask each provider if the key still works
  coo nest                 list what's gathered (names only)
  coo stash <ref>          paste one key into the nest (hidden)
  coo fan <ref>            push the canonical value to every declared site
  coo site <ref> <path> <VAR>   declare where a key must live

a "ref" is service/NAME, e.g. openrouter/API_KEY. values are never printed.
lost? just type coo — it will tell you what's broken and fix it with you.
EOF
}

# ---- keychain (the local nest) ----------------------------------------------
kc_set() { security add-generic-password -U -s "$SERVICE" -a "$1" -w "$2" 2>/dev/null || die "keychain write failed: $1"; }
kc_get() { security find-generic-password -s "$SERVICE" -a "$1" -w 2>/dev/null; }
IDX="$NEST/index"; [[ -f "$IDX" ]] || : > "$IDX"
idx_add() { print "$1" >> "$IDX"; sort -u -o "$IDX" "$IDX"; }

# ---- what shape is this secret? ---------------------------------------------
service_of() {
  case "$1" in
    sk-or-v1-*)               print openrouter ;;
    sk-ant-*)                 print anthropic ;;
    ghp_*|github_pat_*|gho_*) print github ;;
    sb_secret_*)              print supabase ;;
    sk-proj-*|sk-svcacct-*)   print openai ;;
    eyJ*.*.*)                 print jwt ;;
    *) [[ "$1" == 0x[0-9a-fA-F](#c64) || "$1" == [0-9a-fA-F](#c64) ]] && print evm-key || print other ;;
  esac
}
console_of() {
  case "$1" in
    openrouter) print "https://openrouter.ai/settings/keys" ;;
    anthropic)  print "https://console.anthropic.com/settings/keys" ;;
    github)     print "https://github.com/settings/tokens" ;;
    openai)     print "https://platform.openai.com/api-keys" ;;
    supabase|jwt) print "https://supabase.com/dashboard/project/_/settings/api-keys" ;;
    *) print "" ;;
  esac
}

# ---- ask the provider: is this key alive? -----------------------------------
# returns "VERDICT|detail". the whole point of pigeon: a key that exists, parses,
# and is WRONG is the failure that kills agents silently.
probe() {
  local v="$1" verdict="UNKNOWN" detail="no probe for this shape"
  case "$v" in
    sk-or-v1-*)
      local r; r=$(curl -s -m 15 -H "Authorization: Bearer $v" https://openrouter.ai/api/v1/credits 2>/dev/null)
      if [[ "$r" == *'"total_credits"'* ]]; then
        local rem; rem=$(print -r -- "$r" | python3 -c "import sys,json;d=json.load(sys.stdin)['data'];print(f\"{d['total_credits']-d['total_usage']:.2f}\")" 2>/dev/null)
        if [[ "${rem%%.*}" -lt 5 ]] 2>/dev/null; then verdict=LOW; detail="only \$$rem left"; else verdict=ALIVE; detail="\$$rem left"; fi
      else verdict=DEAD; detail="provider rejected it"; fi ;;
    sk-ant-*)
      [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 15 -H "x-api-key: $v" -H 'anthropic-version: 2023-06-01' https://api.anthropic.com/v1/models 2>/dev/null)" == 200 ]] \
        && { verdict=ALIVE; detail=anthropic; } || { verdict=DEAD; detail="anthropic rejected"; } ;;
    ghp_*|github_pat_*)
      [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 15 -H "Authorization: Bearer $v" https://api.github.com/user 2>/dev/null)" == 200 ]] \
        && { verdict=ALIVE; detail=github; } || { verdict=DEAD; detail="github rejected"; } ;;
    eyJ*.*.*)
      local claims; claims=$(print -r -- "$v" | python3 -c "
import sys,json,base64,time
t=sys.stdin.read().strip().split('.')
b=t[1]+'='*(-len(t[1])%4)
d=json.loads(base64.urlsafe_b64decode(b))
role=d.get('role','?'); exp=d.get('exp')
print(f\"EXPIRED|jwt role={role}, expired\" if exp and exp<time.time() else f\"ALIVE|jwt role={role}\")
" 2>/dev/null)
      [[ -n "$claims" ]] && { verdict="${claims%%|*}"; detail="${claims#*|}"; } ;;
  esac
  print "$verdict|$detail"
}

# ---- gather: the hero verb --------------------------------------------------
cmd_gather() {
  local collect=0; [[ "${1:-}" == "--collect" ]] && collect=1
  c cyan "🐦 gathering keys scattered across this machine…"
  print ""
  local -a files
  files=( $HOME/.zshrc $HOME/.bashrc $HOME/.zshenv
          $HOME/CODE/*/.env $HOME/CODE/*/.env.* $HOME/CODE/*/.env.local
          $HOME/.claude/credentials/*.env )
  local tmp; tmp=$(mktemp)
  local f line name value svc
  for f in $files; do
    [[ -f "$f" ]] || continue
    while IFS= read -r line; do
      [[ "$line" == \#* || "$line" != *=* ]] && continue
      name="${line##*export }"; name="${name%%=*}"; name="${name## }"
      value="${line#*=}"; value="${value//\"/}"; value="${value//\'/}"
      [[ ${#value} -ge 20 && "$name" == *(KEY|TOKEN|SECRET|PASSWORD|DSN)* ]] || continue
      svc=$(service_of "$value")
      print "$svc\t$(fp "$value")\t$name\t${f/#$HOME/~}" >> "$tmp"
    done < "$f"
  done
  [[ -s "$tmp" ]] || { c yellow "no keys found. a tidy nest, or an empty one."; rm -f "$tmp"; return 0; }

  local svc_list; svc_list=$(cut -f1 "$tmp" | sort -u)
  local total; total=$(wc -l < "$tmp" | tr -d ' ')
  local services; services=$(print -r -- "$svc_list" | grep -c . )
  # Divergence only ALARMS for account-scoped keys — one account, so every copy
  # should be byte-identical. Per-project keys (a Vercel OIDC token, a Supabase
  # anon key, an EVM wallet key) are SUPPOSED to differ; flagging them is the
  # kind of false red that makes a tool feel dumb on first run.
  local account_scoped=" openrouter anthropic openai github "
  local divergent=0 s n_fp
  while IFS= read -r s; do
    [[ -z "$s" ]] && continue
    n_fp=$(awk -F'\t' -v s="$s" '$1==s{print $2}' "$tmp" | sort -u | grep -c .)
    if [[ "$n_fp" -gt 1 && "$account_scoped" == *" $s "* ]]; then
      c red "  ▲ $s — $n_fp DIFFERENT values for ONE account. one of these is stale."
      divergent=$((divergent+1))
      awk -F'\t' -v s="$s" '$1==s{printf "      %s  %-30s %s\n",$2,$3,$4}' "$tmp" | sort -u
    elif [[ "$s" == other ]]; then
      c green "  ✓ ${n_fp} other service keys (okx, xai, twitter, wallets, …)"
    else
      c green "  ✓ $s (${n_fp} distinct)"
    fi
  done <<< "$svc_list"
  print ""
  c cyan "  $total keys · $services services · $divergent account-key(s) diverged"
  [[ $divergent -gt 0 ]] && c red "  a diverged account key means one copy is stale — that's how an agent dies quiet." \
                          || c green "  no account key has a stale copy. tidy nest."

  if [[ $collect -eq 1 ]]; then
    print ""; c cyan "collecting one canonical value per service into the nest…"
    while IFS= read -r s; do
      [[ -z "$s" || "$s" == other || "$s" == evm-key ]] && continue
      local first_val ref
      first_val=$(awk -F'\t' -v s="$s" 'NR==1||$1==s{}' /dev/null)  # placeholder
    done <<< "$svc_list"
    c yellow "  (interactive collect lands in the next slice — for now: coo stash <service/NAME>)"
  else
    print ""; c 244 "  run \`coo check\` to see which of these are already dead."
  fi
  rm -f "$tmp"
}

# ---- check: the tweet ----------------------------------------------------
cmd_check() {
  local want="${1:-}"
  [[ -s "$IDX" ]] || die "nest is empty — stash a key first:  coo stash openrouter/API_KEY"
  c cyan "🐦 asking each provider if the key still works…"; print ""
  local alive=0 dead=0 unknown=0 ref v res verdict detail color
  while IFS= read -r ref; do
    [[ -z "$ref" ]] && continue
    [[ -n "$want" && "$ref" != $want* ]] && continue
    v=$(kc_get "$ref") || { printf "  %-30s " "$ref"; c red "MISSING (indexed, not in keychain)"; dead=$((dead+1)); continue; }
    res=$(probe "$v"); verdict="${res%%|*}"; detail="${res#*|}"
    case "$verdict" in
      ALIVE) color=green; alive=$((alive+1)) ;;
      LOW)   color=yellow; alive=$((alive+1)) ;;
      DEAD|EXPIRED) color=red; dead=$((dead+1)) ;;
      *) color=244; unknown=$((unknown+1)) ;;
    esac
    printf "  %-30s " "$ref"; print -P "%F{$color}${(r:8:)verdict}%f $detail"
  done < "$IDX"
  print ""
  c cyan "  $alive alive · $dead dead · $unknown unverified"
  [[ $dead -gt 0 ]] && c red "  a dead key that still sits in a config is an agent that fails silently."
}

cmd_nest()  { [[ -s "$IDX" ]] && { c cyan "🐦 the nest:"; sed 's/^/  /' "$IDX"; } || c yellow "the nest is empty."; }
cmd_stash() {
  local ref="${1:-}"; [[ -n "$ref" ]] || die "usage: $SELF stash <service/NAME>"
  local v; print -n "paste value for $ref (hidden): "; read -rs v; print ""
  [[ -n "$v" ]] || die "empty, nothing stashed"
  kc_set "$ref" "$v"; idx_add "$ref"
  c green "✓ stashed $ref ($(fp "$v"), ${#v} chars)"
  [[ "$v" == *.*.* ]] && print -r -- "$v" | python3 -c "import sys,json,base64;t=sys.stdin.read().strip().split('.');b=t[1]+'='*(-len(t[1])%4);print('  jwt role:',json.loads(base64.urlsafe_b64decode(b)).get('role','?'))" 2>/dev/null || true
}

# ---- install: one time, then `coo` works from anywhere ----------------------
cmd_install() {
  local bin="$HOME/.local/bin"; mkdir -p "$bin"
  ln -sf "$SELF_PATH" "$bin/coo"
  c green "✓ installed: $bin/coo → $SELF_PATH"
  case ":$PATH:" in
    *":$bin:"*) c cyan "  done. type \`coo\` from anywhere — that's the whole guide." ;;
    *) c yellow "  one more step — $bin is not on your PATH. run:"
       print "    echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.zshrc && exec zsh" ;;
  esac
}

# ---- setup: ONE command, a smooth guided paste flow ------------------------
# the whole product in one verb. you run `coo`, it tells you what's broken,
# and walks you through pasting fresh keys — verifying each one live before it
# stores it. no AI (you have no keys yet to run one), no dashboard, no account.
cmd_setup() {
  c cyan "🐦 hi. let's sort out your keys."; print ""
  if [[ ! -t 0 ]]; then
    c yellow "  (this is an interactive flow — run \`coo\` in a real terminal.)"
    print "  or use the verbs directly: coo gather · coo check · coo stash <ref>"
    return 0
  fi

  print "  scanning your machine…"
  local tmp; tmp=$(mktemp)
  local f line name value svc
  for f in $HOME/.zshrc $HOME/CODE/*/.env $HOME/CODE/*/.env.local $HOME/.claude/credentials/*.env; do
    [[ -f "$f" ]] || continue
    while IFS= read -r line; do
      [[ "$line" == \#* || "$line" != *=* ]] && continue
      name="${line##*export }"; name="${name%%=*}"; name="${name## }"
      value="${line#*=}"; value="${value//\"/}"; value="${value//\'/}"
      [[ ${#value} -ge 20 && "$name" == *(KEY|TOKEN|SECRET)* ]] || continue
      svc=$(service_of "$value")
      print "$svc\t$value" >> "$tmp"
    done < "$f"
  done

  # For each service we know how to probe, show its current state, then offer a
  # fresh paste for anything DEAD / LOW / not yet in the nest.
  local -a services; services=(openrouter anthropic openai github supabase)
  print ""; c cyan "  here's what I found:"; print ""
  local s val res verdict detail fresh
  for s in $services; do
    val=$(awk -F'\t' -v s="$s" '$1==s{print $2; exit}' "$tmp")
    local stored; stored=$(kc_get "$s/API_KEY" 2>/dev/null || true)
    [[ -z "$val" && -n "$stored" ]] && val="$stored"

    if [[ -z "$val" ]]; then
      printf "  %-12s " "$s"; c 244 "not found"
      continue
    fi
    res=$(probe "$val"); verdict="${res%%|*}"; detail="${res#*|}"
    case "$verdict" in
      ALIVE) printf "  %-12s " "$s"; print -P "%F{green}ALIVE%f  $detail"; continue ;;
      LOW)   printf "  %-12s " "$s"; print -P "%F{yellow}LOW%f    $detail — worth replacing" ;;
      DEAD|EXPIRED) printf "  %-12s " "$s"; print -P "%F{red}DEAD%f   $detail" ;;
      *)     printf "  %-12s " "$s"; print -P "%F{green}$verdict%f $detail"; continue ;;
    esac

    # broken → guided paste
    print -n "  └─ paste a fresh $s key here (hidden, or Enter to skip) ▸ "
    read -rs fresh; print ""
    [[ -z "$fresh" ]] && { c 244 "     skipped."; continue; }
    local vres; vres=$(probe "$fresh"); local vv="${vres%%|*}"
    if [[ "$vv" == DEAD || "$vv" == EXPIRED ]]; then
      c red "     that one's also rejected by the provider — not stored. try again with \`coo stash $s/API_KEY\`."
      continue
    fi
    kc_set "$s/API_KEY" "$fresh"; idx_add "$s/API_KEY"
    c green "     ✓ verified (${vres#*|}) and gathered into the nest."
  done
  rm -f "$tmp"

  # ---- pending sites: any key with a declared home gets FINISHED right here.
  # this is the piece that makes `coo` the whole guide: if a site was declared
  # (by you, or an agent setting up a task), the flow ends with the key landed —
  # never with "now go run two more commands."
  local site_refs
  site_refs=$(python3 -c "import json,sys;print('\n'.join(json.load(open(sys.argv[1])).keys()))" "$SITES" 2>/dev/null || true)
  if [[ -n "$site_refs" ]]; then
    print ""; c cyan "  keys with declared homes:"
    local sref sv
    while IFS= read -r sref; do
      [[ -z "$sref" ]] && continue
      if kc_get "$sref" >/dev/null 2>&1; then
        cmd_fan "$sref" || true
      else
        c yellow "  $sref has a declared home but no key in the nest yet."
        print -n "  └─ paste it now (hidden, or Enter to skip) ▸ "
        read -rs sv; print ""
        if [[ -z "$sv" ]]; then c 244 "     skipped."; continue; fi
        kc_set "$sref" "$sv"; idx_add "$sref"
        c green "     ✓ stashed $sref ($(fp "$sv"), ${#sv} chars)"
        [[ "$sv" == *.*.* ]] && print -r -- "$sv" | python3 -c "import sys,json,base64;t=sys.stdin.read().strip().split('.');b=t[1]+'='*(-len(t[1])%4);print('     jwt role:',json.loads(base64.urlsafe_b64decode(b)).get('role','?'))" 2>/dev/null || true
        cmd_fan "$sref" || true
      fi
    done <<< "$site_refs"
  fi

  print ""; c cyan "🐦 your nest:"
  cmd_check 2>/dev/null || true
  print ""; c 244 "  run \`coo\` anytime to re-check, or \`coo fan <ref>\` to push a key everywhere it lives."
}

# ---- fan: one paste → every place a key lives -------------------------------
# the copy-paste killer. declare where a key lives once, then `coo fan <ref>`
# writes the canonical nest value to every declared .env, backing up what it
# replaced. this is the fix for the bug that started pigeon: four copies, one
# goes stale, an agent dies quiet. values are never printed — only fingerprints.
cmd_site() {
  local ref="${1:-}" target="${2:-}" var="${3:-}"   # never name a local `path` in zsh
  [[ -n "$ref" && -n "$target" && -n "$var" ]] \
    || die "usage: $SELF site <service/NAME> <file-path> <VAR_NAME>"
  SITES_F="$SITES" REF="$ref" P="${target/#\~/$HOME}" V="$var" python3 - <<'PY'
import json, os
f = os.environ['SITES_F']; d = json.load(open(f))
entry = {"path": os.environ['P'], "var": os.environ['V']}
lst = d.setdefault(os.environ['REF'], [])
if entry not in lst: lst.append(entry)
json.dump(d, open(f, 'w'), indent=2)
print(f"declared: {os.environ['REF']} → {os.environ['P']} ({os.environ['V']})")
PY
}

cmd_fan() {
  local ref="${1:-}"
  [[ -n "$ref" ]] || die "usage: $SELF fan <service/NAME>   (declare sites first: $SELF site …)"
  local can; can=$(kc_get "$ref") || die "no key stored for $ref — stash it first: $SELF stash $ref"

  c cyan "🐦 fanning $ref ($(fp "$can")) to every declared site…"; print ""
  local wrote=0 same=0 miss=0
  # show the plan + drift, then write. python does the file edits atomically-ish
  # (write to a temp, back up the original, move) and reports one line per site.
  local report
  report=$(SITES_F="$SITES" REF="$ref" CAN="$can" python3 - <<'PY'
import json, os, shutil, hashlib, sys
d = json.load(open(os.environ['SITES_F'])); ref = os.environ['REF']; can = os.environ['CAN']
def fp(v): return hashlib.sha1(v.encode()).hexdigest()[:8]
sites = d.get(ref, [])
if not sites:
    print("NOSITES"); sys.exit(0)
w=s=m=0
for site in sites:
    p, var = site['path'], site['var']
    try:
        lines = open(p).readlines()
    except OSError:
        print(f"MISS\t{p}\t{var} (file unreadable)"); m+=1; continue
    out, found, changed = [], False, False
    for line in lines:
        ls = line.strip(); bare = ls.replace('export ', '', 1)
        if not ls.startswith('#') and bare.startswith(var + '='):
            found = True
            old = bare.split('=', 1)[1].strip().strip('"').strip("'")
            if old == can:
                out.append(line)
            else:
                pre = 'export ' if ls.startswith('export ') else ''
                ind = line[:len(line)-len(line.lstrip())]
                out.append(f'{ind}{pre}{var}={can}\n'); changed = True
                print(f"WROTE\t{p}\t{fp(old)} → {fp(can)}")
        else:
            out.append(line)
    if not found:
        out.append(f'{var}={can}\n'); changed = True
        print(f"WROTE\t{p}\t(added {var})")
    if changed:
        shutil.copy2(p, p + '.bak-pigeon')     # always reversible
        open(p, 'w').writelines(out); w+=1
    elif found:
        print(f"SAME\t{p}\talready canonical"); s+=1
print(f"TALLY\t{w}\t{s}\t{m}")
PY
)
  if [[ "$report" == "NOSITES" ]]; then
    c yellow "  no sites declared for $ref."
    print "  declare one:  $SELF site $ref ~/CODE/yourproj/.env OPENROUTER_API_KEY"
    return 0
  fi
  local kind a b extra
  while IFS=$'\t' read -r kind a b extra; do
    case "$kind" in
      WROTE) c green  "  ✓ ${a/#$HOME/~}  $b" ;;
      SAME)  c 244    "  · ${a/#$HOME/~}  $b" ;;
      MISS)  c yellow "  ⚠ ${a/#$HOME/~}  $b" ;;
      TALLY) print ""; c cyan "  $a written · $b already-canonical · $extra unreachable"
             [[ "$a" -gt 0 ]] && c 244 "  each changed file backed up as <file>.bak-pigeon" ;;
    esac
  done <<< "$report"
}

case "${1:-}" in
  ""|setup) cmd_setup ;;
  install)  cmd_install ;;
  gather)   shift; cmd_gather "$@" ;;
  check)    shift; cmd_check  "$@" ;;
  nest)     shift; cmd_nest   "$@" ;;
  stash)    shift; cmd_stash  "$@" ;;
  site)     shift; cmd_site   "$@" ;;
  fan)      shift; cmd_fan    "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $1 (try \`$SELF help\`)" ;;
esac
