#!/bin/zsh
# pigeon — carrier pigeon for your API keys. gather them, check them, keep them alive.
#
#   coo gather   scan the machine, find every scattered key, show divergence
#   coo check    ask each provider: alive? dead? drained? wrong role?
#   coo nest     list what's gathered (names only, never values)
#   coo fan      push the canonical value to every place a key should live
#
# storage is a solved problem (1Password, SOPS, age). pigeon does NOT reinvent a
# vault. it does the thing none of them do: keep a heterogeneous AGENT FLEET's
# keys alive — across repos, a VPS, Vercel, and each agent's own auth store.
#
# free. local. no server, no account, no per-seat fee. values never leave the
# machine and are never printed. mac-first for v0.1; portable backend is roadmap.
#
# MIT. https://github.com/Morkeeth/pigeon

set -euo pipefail
# zsh prints "name=value" when `local name` re-declares a name already live in
# scope — which happens on every loop iteration. For a tool whose promise is
# "values are never printed", that is a key leak, not a cosmetic wart. The
# locals below are all hoisted out of their loops; this makes the whole class
# impossible to reintroduce.
setopt typeset_silent
SERVICE="pigeon-nest"
SELF="${0:t}"
SELF_PATH="${0:A}"   # resolved at top level, where $0 is the script — inside a function zsh makes $0 the function name
NEST="${XDG_DATA_HOME:-$HOME/.local/share}/pigeon"
mkdir -p "$NEST"
SITES="$NEST/sites.json"; [[ -f "$SITES" ]] || print '{}' > "$SITES"
RECENT="$NEST/recent"      # providers you actually reach for, most-recent-first

c()   { print -P "%F{$1}$2%f"; }
die() { print -u2 "✗ $*"; exit 1; }
fp()  { printf '%s' "$1" | shasum | cut -c1-8; }   # identity, never exposure

usage() {
  cat <<'EOF'
🐦 pigeon — gather, check and rotate API keys across your agent fleet

  coo                      pick a key (type to filter 60 providers) → paste once → it lands
                           in every file on this machine that already holds one
  coo doctor               probe every key found on this machine, fix the broken ones
  coo install              put coo on your PATH (run once, then just type coo)
  coo gather               find every key on this machine, flag stale copies
  coo check [service]      ask each provider if the key still works
  coo nest                 list what's gathered (names only)
  coo stash <ref>          paste one key into the nest (hidden)
  coo rotate <ref>         paste a new value, verify live, land it, revoke the old
  coo remove <ref>         delete a key from the nest
  coo fan <ref>            push the stored value to every declared home
  coo site <ref> <path> <VAR>   declare a home by hand (coo usually does this for you)

for scripts and agents:
  coo check --json         {alive, dead, unverified, keys:[{ref,verdict,detail,fingerprint}]}
  coo nest --json          the refs, as a JSON array
  printf %s "$K" | coo stash <ref> --stdin      store without a terminal
  exit codes: check → 0 nothing dead, 1 something dead

a "ref" is service/NAME, e.g. openrouter/API_KEY. values are never printed.
lost? just type coo — it will tell you what's broken and fix it with you.
EOF
}

# ---- keychain (the local nest) ----------------------------------------------
kc_set() {
  security add-generic-password -U -s "$SERVICE" -a "$1" -w "$2" 2>/dev/null && return 0
  print -u2 "✗ could not write $1 to the macOS Keychain."
  command -v security >/dev/null 2>&1 \
    && print -u2 "  the keychain may be locked — unlock it in Keychain Access and run again." \
    || print -u2 "  no \`security\` binary: pigeon's nest is macOS-only until the age backend lands (ROADMAP v0.3)."
  exit 1
}
kc_get() { security find-generic-password -s "$SERVICE" -a "$1" -w 2>/dev/null; }
IDX="$NEST/index"; [[ -f "$IDX" ]] || : > "$IDX"
idx_add() { print "$1" >> "$IDX"; sort -u -o "$IDX" "$IDX"; }

